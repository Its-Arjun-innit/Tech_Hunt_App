# ── Database ────────────────────────────────────────────────────────
# Local dev: a PostgreSQL instance on this machine.
# Production: Supabase → Settings → Database → Connection string.
#   DATABASE_URL uses the pooled (pgBouncer, port 6543) connection.
#   DIRECT_URL uses the direct (port 5432) connection for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/treasurehunt"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/treasurehunt"

# ── Auth ────────────────────────────────────────────────────────────
# Random 32+ char secret. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Seeded super admin account.
ADMIN_EMAIL="admin@campus.edu"
ADMIN_PASSWORD="admin1234"

# ── App ─────────────────────────────────────────────────────────────
# Public origin, used to build the URL encoded into each checkpoint QR code.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google Maps (admin map is optional; app works without a key) ─────
# Browser key: restrict by HTTP referrer, enable Maps JavaScript + Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key: restrict by IP, enable Geocoding API. Only needed for geocoding.
GOOGLE_MAPS_API_KEY=""

# ── Supabase (only needed for Realtime / Storage; not required for MVP) ──
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
