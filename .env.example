# ── Database ────────────────────────────────────────────────────────
# Local dev: a PostgreSQL instance on this machine.
# Production: Supabase → Settings → Database → Connection string.
#   DATABASE_URL uses the pooled (pgBouncer, port 6543) connection.
#   DIRECT_URL uses the direct (port 5432) connection for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/treasurehunt"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/treasurehunt"

# ── Auth ────────────────────────────────────────────────────────────
# The first admin. Created automatically on deploy if no admin exists.
ADMIN_EMAIL="admin@campus.edu"
ADMIN_PASSWORD="admin1234"

# ── App ─────────────────────────────────────────────────────────────
# Public origin, used to build the URL inside the rotating attendance QR.
# On Vercel this is derived automatically and can be left unset.
APP_URL="http://localhost:3000"

# The college's time zone. Decides which class is "now" and what "today" is,
# since servers run in UTC. Any IANA zone name.
CAMPUS_TZ="Asia/Kolkata"
