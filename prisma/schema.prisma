// Campus app — data model for one college.
// Source of truth for every attendance mark, timetable and notice. Never trust the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Structure ────────────────────────────

model Department {
  id   String @id @default(cuid())
  name String
  code String @unique

  sections Section[]
  subjects Subject[]
  staff    Staff[]
}

model Section {
  id           String @id @default(cuid())
  departmentId String
  /// e.g. "CSE-A"
  name         String @unique
  year         Int    @default(1)
  semester     Int    @default(1)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students   Student[]
  courses    Course[]
}

model Subject {
  id           String @id @default(cuid())
  departmentId String
  code         String @unique
  name         String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courses    Course[]
}

model Room {
  id        String  @id @default(cuid())
  name      String  @unique
  building  String?
  /// Unset coordinates switch the location check off for this room.
  latitude  Float?
  longitude Float?
  radiusM   Int     @default(60)

  slots              TimetableSlot[]
  exceptions         SlotException[]
  attendanceSessions AttendanceSession[]
}

/// Who teaches which subject to which section. Timetable slots, attendance
/// sessions and reports all hang off this row.
model Course {
  id        String @id @default(cuid())
  subjectId String
  sectionId String
  teacherId String

  subject  Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section  Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher  Staff               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  slots    TimetableSlot[]
  sessions AttendanceSession[]

  @@unique([subjectId, sectionId])
  @@index([teacherId])
}

// ─────────────────────────────── People ─────────────────────────────

enum StudentStatus {
  ACTIVE
  DISABLED
}

model Student {
  id          String        @id @default(cuid())
  sectionId   String
  rollNo      String        @unique
  name        String
  pinHash     String
  status      StudentStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  section  Section            @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  sessions StudentSession[]
  records  AttendanceRecord[]
  reads    NoticeRead[]
}

/// One row per signed-in device. Creating a session deletes the others, so a
/// student is signed in on one phone at a time; that is the proxy guard.
model StudentSession {
  id        String   @id @default(cuid())
  token     String   @unique
  studentId String
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum StaffRole {
  TEACHER
  HOD
  ADMIN
}

model Staff {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         StaffRole @default(TEACHER)
  departmentId String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department    Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessions      StaffSession[]
  courses       Course[]
  notices       Notice[]
  substitutions SlotException[]
  opened        AttendanceSession[]
  marked        AttendanceRecord[]
}

model StaffSession {
  id        String   @id @default(cuid())
  token     String   @unique
  staffId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

// ───────────────────────────── Timetable ────────────────────────────

/// A weekly recurring class. Minutes are counted from local midnight in the
/// campus time zone (CAMPUS_TZ), so 9:30 is 570.
model TimetableSlot {
  id        String  @id @default(cuid())
  courseId  String
  roomId    String?
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek Int
  startMin  Int
  endMin    Int

  course     Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  room       Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  exceptions SlotException[]
  sessions   AttendanceSession[]

  @@index([dayOfWeek])
}

/// A one-day change to a slot: cancelled, moved, another room or a substitute.
/// Null fields keep the slot's usual value.
model SlotException {
  id           String   @id @default(cuid())
  slotId       String
  date         DateTime @db.Date
  cancelled    Boolean  @default(false)
  startMin     Int?
  endMin       Int?
  roomId       String?
  substituteId String?
  note         String?
  createdAt    DateTime @default(now())

  slot       TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  room       Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  substitute Staff?        @relation(fields: [substituteId], references: [id], onDelete: SetNull)

  @@unique([slotId, date])
  @@index([date])
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

// ───────────────────────────── Attendance ───────────────────────────

/// One class meeting a teacher opened for marking. Open while now < closesAt;
/// marks after lateAt count as LATE. Both are compared at read time, so no job
/// ever closes a session or writes ABSENT rows: no record means absent.
model AttendanceSession {
  id         String   @id @default(cuid())
  courseId   String
  slotId     String?
  roomId     String?
  openedById String
  date       DateTime @db.Date
  /// Public id in the QR link. Never a database id.
  token      String   @unique
  /// HMAC key for the rotating six-digit code. Never leaves the server.
  secret     String
  openedAt   DateTime @default(now())
  lateAt     DateTime
  closesAt   DateTime

  course   Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slot     TimetableSlot?     @relation(fields: [slotId], references: [id], onDelete: SetNull)
  room     Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  openedBy Staff              @relation(fields: [openedById], references: [id], onDelete: Restrict)
  records  AttendanceRecord[]

  @@index([courseId, openedAt])
  @@index([closesAt])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum MarkMethod {
  QR
  CODE
  MANUAL
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  sessionId  String
  studentId  String
  status     AttendanceStatus
  method     MarkMethod
  latitude   Float?
  longitude  Float?
  distanceM  Int?
  /// Accepted but worth a teacher's look, e.g. outside the room radius.
  flagged    Boolean          @default(false)
  flagReason String?
  markedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  session  AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student  Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy Staff?            @relation(fields: [markedById], references: [id], onDelete: SetNull)

  /// Two taps, two phones or a retry all land on this constraint: one mark per class.
  @@unique([sessionId, studentId])
  @@index([studentId])
}

// ─────────────────────────────── Notices ────────────────────────────

enum NoticeAudience {
  ALL
  DEPARTMENT
  SECTION
}

model Notice {
  id            String         @id @default(cuid())
  authorId      String
  title         String
  body          String
  audience      NoticeAudience @default(SECTION)
  /// Department or section id; null for ALL.
  targetId      String?
  pinned        Boolean        @default(false)
  urgent        Boolean        @default(false)
  attachmentUrl String?
  /// Future-dated notices stay hidden until this passes. Read-time, no job.
  scheduledFor  DateTime?
  createdAt     DateTime       @default(now())

  author Staff        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads  NoticeRead[]

  @@index([audience, targetId, createdAt])
}

model NoticeRead {
  noticeId  String
  studentId String
  readAt    DateTime @default(now())

  notice  Notice  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([noticeId, studentId])
}

// ───────────────────────────── Settings, audit ──────────────────────

enum GeoMode {
  /// Location is not checked.
  OFF
  /// Marks outside the room radius are accepted and flagged for the teacher.
  FLAG
  /// Marks outside the room radius are refused.
  REJECT
}

/// Single row, id 1.
model Settings {
  id               Int     @id @default(1)
  /// Below this percentage a student is a defaulter.
  minAttendancePct Int     @default(75)
  /// Minutes after opening that a mark still counts as present.
  lateAfterMin     Int     @default(10)
  /// Minutes a session stays open for marking.
  sessionMinutes   Int     @default(15)
  geoMode          GeoMode @default(FLAG)
}

enum ActorType {
  STAFF
  STUDENT
  SYSTEM
}

model AuditLog {
  id        String    @id @default(cuid())
  actorType ActorType
  actorId   String?
  actorName String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([action, actorId, createdAt])
}
